#!/usr/bin/env bash
# A git credential helper that mints a persona's App token on demand
# (#43, intent/43-harness-agnostic-launch/spec.md D13).
#
#   git -c credential.https://github.com.helper='<abs path> <persona>' push …
#
# Why a helper rather than a token in the environment: `git` does not
# read GH_TOKEN at all, and an App installation token lives about an
# hour while odyssey's execution cap is ninety minutes — so a snapshot
# taken at launch fails a long session mid-push, at the one moment the
# work is finished and about to be lost. This helper is asked for a
# credential each time git needs one and mints a fresh token then.
#
# scripts/ops/work.sh installs it through the LAUNCHED CHILD's
# environment only (GIT_CONFIG_COUNT / GIT_CONFIG_KEY_n /
# GIT_CONFIG_VALUE_n), never into .git/config, so a crashed session
# leaves no credential configuration behind and the operator's own shell
# is untouched.
#
# The token is written to stdout in git's own credential protocol and
# nowhere else: not to a file, not to argv, not to stderr, not to a log.
# mint_app_token.py is resolved from BASH_SOURCE, so this script names
# no home directory and needs no sanitize allowlist entry.

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MINT="$HERE/mint_app_token.py"

persona="${1:-}"
action="${2:-}"

if [ -z "$persona" ] || [ -z "$action" ]; then
    echo "usage: git-credential-persona <persona> <get|store|erase>" >&2
    exit 1
fi
case "$persona" in
    *[!a-z-]*) echo "git-credential-persona: '$persona' is not a persona name" >&2
               exit 1 ;;
esac

case "$action" in
    store|erase)
        # git calls these after a successful or failed authentication.
        # There is nothing to cache — the whole point is that each call
        # mints anew — but a helper that FAILS on them fails the push,
        # so they are no-ops that exit 0.
        exit 0
        ;;
    get) ;;
    *)
        echo "git-credential-persona: unknown action '$action'" >&2
        exit 1
        ;;
esac

# git writes the request (protocol=, host=, path=…) on stdin and closes
# it. Drain it: a helper that leaves the pipe unread can make git see a
# write error on a large request.
cat >/dev/null || true

[ -x "$MINT" ] || { echo "git-credential-persona: $MINT is not executable" >&2; exit 1; }

token=""
token="$("$MINT" "$persona")" \
    || { echo "git-credential-persona: cannot mint an App token for $persona" >&2; exit 1; }
[ -n "$token" ] \
    || { echo "git-credential-persona: the token minted for $persona is empty" >&2; exit 1; }

printf 'username=x-access-token\n'
printf 'password=%s\n' "$token"
printf '\n'
